{
  "name": "active-record-ts",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript port of Rails ActiveRecord. Monorepo for arel, active-model, and active-record.",
  "author": "Alexander Stathis <stathis.alexanderj@gmail.com> (github.com/stathis-alexander)",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "mysql2": "^3.22.3",
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,json,jsonc}": ["biome check --write"]
  },
  "scripts": {
    "lint": "biome check",
    "typecheck": "bun tsc --noEmit",
    "test": "bun test",
    "test:arel": "bun test --cwd packages/arel",
    "test:active-model": "bun test --cwd packages/active-model",
    "test:active-record": "bun test --cwd packages/active-record",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down -v",
    "db:create": "bun packages/active-record/bin/active-record.ts db:create",
    "db:drop": "bun packages/active-record/bin/active-record.ts db:drop",
    "db:migrate": "bun packages/active-record/bin/active-record.ts db:migrate",
    "db:rollback": "bun packages/active-record/bin/active-record.ts db:rollback",
    "db:schema:dump": "bun packages/active-record/bin/active-record.ts db:schema:dump",
    "db:schema:load": "bun packages/active-record/bin/active-record.ts db:schema:load"
  }
}
