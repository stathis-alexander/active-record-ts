{
  "$schema": "https://biomejs.dev/schemas/2.1.3/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "**/*.json", "**/*.jsonc", "!**/node_modules/**"]
  },
  "formatter": {
    "bracketSameLine": true,
    "bracketSpacing": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "jsxQuoteStyle": "single",
      "quoteProperties": "preserve",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "linter": {
    "rules": {
      // Relation and association proxies intentionally implement PromiseLike
      // by defining a `then` method so consumers can `await` them. This rule
      // catches accidentally-thenable objects; here it's deliberate.
      "suspicious": {
        "noThenProperty": "off"
      },
      "complexity": {
        // Static methods use `new this(...)` and `this as typeof Base` to
        // preserve the late-bound subclass type. Biome's auto-fix rewrites
        // `this` to the literal class name, which breaks generic constructor
        // signatures like `<T extends Base>(this: new (...) => T)`.
        "noThisInStatic": "off"
      }
    }
  },
  "assist": {
    "actions": {
      // Import ordering is a preference, not a correctness issue. Run
      // `biome check --write` locally if you want imports auto-sorted.
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
